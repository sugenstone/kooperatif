# Local development infrastructure (docker/compose.yaml) example values.
# Copy to .env at the repository root (gitignored) to override.
POSTGRES_USER=kooperatif
POSTGRES_PASSWORD=kooperatif_dev_password
POSTGRES_DB=kooperatif
POSTGRES_PORT=5494

# Backup / disaster recovery (scripts/backup/, docs/23, ADR-013).
# In production keep KOOPERATIF_BACKUP_DIR outside the repo and inject
# the database URL via the secret store — never commit credentials.
KOOPERATIF_BACKUP_DIR=backups
# Tooling: "docker" (pinned postgres:17-alpine image) or "host" (PATH).
KOOPERATIF_BACKUP_TOOLING=docker
# KOOPERATIF_BACKUP_DATABASE_URL=postgres://kooperatif:kooperatif_dev_password@localhost:5494/kooperatif
# Staleness gate for `pnpm backup:status` (hours since last success).
KOOPERATIF_BACKUP_MAX_AGE_HOURS=24
# Opt-in source-identity guard (M1-P2 B1): backup:create refuses to run
# pg_dump unless the source connection's current_database() matches.
# The same variable also guards the server binary
# (see apps/server/.env.example); REQUIRED during the B1 transition so
# commands cannot target the preserved historical `kooperatif` database
# while developing against `kooperatif_dev`.
#KOOPERATIF_EXPECTED_DATABASE=kooperatif_dev
# Retention policy (ADR-013): daily days / monthly months / yearly years.
# 0 yearly = keep yearly anchors indefinitely (conservative default).
KOOPERATIF_BACKUP_KEEP_DAILY_DAYS=30
KOOPERATIF_BACKUP_KEEP_MONTHLY_MONTHS=12
KOOPERATIF_BACKUP_KEEP_YEARLY_YEARS=0
