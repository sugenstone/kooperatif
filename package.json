{
	"name": "kooperatif",
	"private": true,
	"version": "0.1.0",
	"packageManager": "pnpm@10.15.0",
	"engines": {
		"node": ">=22"
	},
	"scripts": {
		"dev": "pnpm --filter @kooperatif/web dev",
		"dev:server": "cargo run --manifest-path apps/server/Cargo.toml",
		"build": "pnpm --filter @kooperatif/web build",
		"check": "pnpm --filter @kooperatif/contracts check && pnpm --filter @kooperatif/web check",
		"lint": "pnpm --filter @kooperatif/web lint",
		"format": "pnpm --filter @kooperatif/web format",
		"test": "pnpm --filter @kooperatif/web test",
		"rust:fmt": "cargo fmt --manifest-path apps/server/Cargo.toml --check",
		"rust:fmt:fix": "cargo fmt --manifest-path apps/server/Cargo.toml",
		"rust:clippy": "cargo clippy --manifest-path apps/server/Cargo.toml --all-targets -- -D warnings",
		"rust:test": "cargo test --manifest-path apps/server/Cargo.toml",
		"db:verify": "bash scripts/db-verify.sh",
		"backup:create": "node scripts/backup/create.mjs",
		"backup:verify": "node scripts/backup/verify.mjs",
		"backup:restore": "node scripts/backup/restore.mjs",
		"backup:status": "node scripts/backup/status.mjs",
		"backup:retention": "node scripts/backup/retention.mjs",
		"backup:drill": "node scripts/backup/drill.mjs",
		"backup:failure-test": "node scripts/backup/failure-test.mjs",
		"backup:test": "node --test \"scripts/backup/tests/*.test.mjs\"",
		"verify": "bash scripts/verify.sh"
	},
	"pnpm": {
		"overrides": {
			"source-map-js": "1.2.2",
			"cookie": "0.7.2"
		}
	}
}
