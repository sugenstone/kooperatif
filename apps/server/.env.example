# Kooperatif backend (apps/server) example environment.
# Copy to apps/server/.env (gitignored) or export in your shell.

# development | test | production (required semantics; defaults to development)
KOOPERATIF_ENV=development

# Bind address. Defaults: 127.0.0.1 (development/test), 0.0.0.0 (production,
# expected to sit behind the reverse proxy of ADR-012).
#KOOPERATIF_HOST=127.0.0.1

# Listen port. Default: 8080.
#KOOPERATIF_PORT=8080

# PostgreSQL connection string. REQUIRED in production; optional elsewhere
# (without it the server runs but /ready reports the database as
# "unconfigured").
KOOPERATIF_DATABASE_URL=postgres://kooperatif:kooperatif_dev_password@localhost:5494/kooperatif

# Restricted runtime principal (M1-P4-P1). When set, `serve` connects
# as `kooperatif_app` (NOSUPERUSER, NOBYPASSRLS) while `migrate` and
# every admin CLI command keep using KOOPERATIF_DATABASE_URL.
# REQUIRED in production. Optional in development: the runtime falls
# back to the admin URL until RLS is enabled (M1-P4-P3), at which
# point serving as the schema owner would silently bypass policies.
# Provision the password out-of-band — it is never committed:
#   ALTER ROLE kooperatif_app PASSWORD '…';
#KOOPERATIF_APP_DATABASE_URL=postgres://kooperatif_app:...@localhost:5494/kooperatif_dev

# M1-P4-P2A: explicit development opt-in to serve on the administrative
# principal when KOOPERATIF_APP_DATABASE_URL is unset. Without it the
# server refuses to start on the schema owner — the privileged fallback
# can never happen silently. NEVER valid in production (config error).
# Note: even when set, startup verifies the connected principal and the
# privileged mode is announced via WARN; if the app URL itself points at
# a superuser/owner, startup fails closed.
#KOOPERATIF_ALLOW_ADMIN_RUNTIME=false

# Opt-in fail-closed database-identity guard (M1-P2 B1 transition).
# When set, server startup and every mutating CLI command (migrate,
# create-user, grant-role, create-cooperative, add-member,
# bootstrap-cooperative) verify current_database() on the configured
# connection BEFORE any write and refuse to run on mismatch. REQUIRED
# for the B1 transition so operations cannot accidentally target the
# preserved historical `kooperatif` database while developing against
# `kooperatif_dev`. Unset preserves the previous behavior.
#KOOPERATIF_EXPECTED_DATABASE=kooperatif_dev

# Comma-separated list of allowed CORS origins (development convenience,
# e.g. the Vite dev server). Empty by default: same-origin only.
#KOOPERATIF_CORS_ORIGINS=http://localhost:5173

# --- Authentication / sessions (STEP-002, ADR-002) ---

# Origins accepted by the CSRF Origin check on state-changing auth
# requests. Development defaults to the Vite dev server; production MUST
# set its public origin explicitly (startup fails otherwise).
#KOOPERATIF_ALLOWED_ORIGINS=https://kooperatif.example.com

# Secure attribute on the session cookie. Default: true in production,
# false in development (plain localhost). Forcing false in production is
# a startup error.
#KOOPERATIF_COOKIE_SECURE=false

# Absolute session lifetime (seconds). Default: 43200 (12h). Range 60..31536000.
#KOOPERATIF_SESSION_ABSOLUTE_TTL_SECS=43200

# Idle timeout (seconds), refreshed by bounded touch (max one write per
# 5 minutes). Default: 1800 (30min). Must be smaller than the absolute TTL.
#KOOPERATIF_SESSION_IDLE_TTL_SECS=1800

# Argon2id parameters. Defaults (OWASP): m=19456 KiB, t=2, p=1.
# Enforced floors: m >= 8192, t in 1..=10, p in 1..=4 — weaker values are
# rejected at startup. Tests may use the floor to stay fast.
#KOOPERATIF_ARGON2_M_COST=19456
#KOOPERATIF_ARGON2_T_COST=2
#KOOPERATIF_ARGON2_P_COST=1

# Login rate limiting (fixed windows; automatic recovery; no permanent
# lockout). Username dimension counts FAILED logins; IP dimension counts
# ALL attempts (defeats username spraying). In-process/single-node by
# design (ADR-012); move to PostgreSQL when a second node appears.
#KOOPERATIF_LOGIN_WINDOW_SECS=300
#KOOPERATIF_LOGIN_USERNAME_MAX_ATTEMPTS=10
#KOOPERATIF_LOGIN_IP_MAX_ATTEMPTS=30

# Trust the rightmost X-Forwarded-For entry as the client IP. Enable ONLY
# behind the reverse proxy of the ADR-012 topology (spoofed left entries
# cannot influence the key).
#KOOPERATIF_FORWARDED_IP=false

# Log filter (tracing-subscriber EnvFilter syntax). Optional.
#RUST_LOG=kooperatif_server=info,tower_http=info
